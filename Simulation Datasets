generate_dataset <- function(type, n, d, k, m, imbalance_ratio) {

  if (imbalance_ratio == 0) {
    n_majority <- n
    n_minority <- 0
  } else {
    n_minority <- n / (1 + imbalance_ratio)
    n_majority <- n - n_minority
  }

  if (type == 3) {
    mu_majority <- rep(0, d)
    mu_minority <- rep(0, d)
  } else {
    mu_majority <- rep(1.5, d)
    mu_minority <- rep(-1.5, d)
  }
  
  sigma <- diag(d) * 1.5
  X_con_majority <- mvrnorm(n_majority, mu_majority, sigma)
  if (n_minority > 0) {
    X_con_minority <- mvrnorm(n_minority, mu_minority, sigma)
  }
  
  generate_categorical <- function(n, k, m, class, type) {
    if (n == 0) return(data.frame())      
    prob_matrix <- matrix(0, nrow = k, ncol = m)
    
    if (type == 2) {
      for (i in 1:k) {
        prob_matrix[i, 1] <- 0.6 + (i - 1) * (0.75 - 0.6) / (k - 1)
        prob_matrix[i, -1] <- (1 - prob_matrix[i, 1]) / (m - 1)
      }
    } else {
      if (class == 0) {
        for (i in 1:k) {
          prob_matrix[i, 1] <- 0.6 + (i - 1) * (0.75 - 0.6) / (k - 1)
          prob_matrix[i, -1] <- (1 - prob_matrix[i, 1]) / (m - 1)
        }
      } else {
        for (i in 1:k) {
          prob_matrix[i, m] <- 0.6 + (i - 1) * (0.75 - 0.6) / (k - 1)
          prob_matrix[i, 1:(m - 1)] <- (1 - prob_matrix[i, m]) / (m - 1)
        }
      }
    }
    
    categorical_data <- data.frame(
      lapply(1:k, function(x)
        sample(1:m, n, replace = TRUE, prob = prob_matrix[x, ])))
    colnames(categorical_data) <- paste("Cat", 1:k, sep = "_")
    return(categorical_data)
  }
  
  X_cat_majority <- generate_categorical(n_majority, k, m, class = 0, type = type)
  X_cat_minority <- generate_categorical(n_minority, k, m, class = 1, type = type)
  
  df_majority <- data.frame(
    X_cat_majority,
    as.data.frame(X_con_majority),
    Class = 0)
  colnames(df_majority)[(k + 1):(k + d)] <- paste("Cont", 1:d, sep = "_")
  
  if (n_minority > 0) {
    df_minority <- data.frame(
      X_cat_minority,
      as.data.frame(X_con_minority),
      Class = 1)
    colnames(df_minority)[(k + 1):(k + d)] <- paste("Cont", 1:d, sep = "_")
    df <- rbind(df_majority, df_minority)
  } else {
    df <- df_majority
  }
  
  return(df)
}
